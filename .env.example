# Horus environment template.
# Copy to .env for local development. Never commit .env.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

API_URL=https://api.example.com
API_KEY=your_api_key_here

AXE_SIG=AXE_UNVERIFIED
BUILD_FINGERPRINT=DEV_LOCAL
COMMIT_HASH=local_dev
BUILD_TIMESTAMP=dev
APP_VERSION=1.0.0
