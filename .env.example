# ============================================================================
# Horus Environment Configuration - Example File
# ============================================================================
# HOW TO USE:
# 1. Copy this file and save it as .env in the project root
# 2. Fill in your actual configuration values
# 3. NEVER commit .env to version control (it's in .gitignore)
# 4. For development: Use placeholder values (they will work in dev mode)
# 5. For production: Use real credentials from your Supabase project
# ============================================================================

# ── Supabase Configuration ────────────────────────────────────────────────
# Your Supabase project URL
# Get from: https://app.supabase.com/project/[project-id]/settings/api
# Format: https://your-project-id.supabase.co
SUPABASE_URL=https://blnquixwsaxcazttuyrx.supabase.co

# Your Supabase anonymous (public) key
# Get from: https://app.supabase.com/project/[project-id]/settings/api
# This key is safe to expose in client-side code
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJsbnF1aXh3c2F4Y2F6dHR1eXJ4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk5MDcxNzgsImV4cCI6MjA5NTQ4MzE3OH0.0aDwN6To2O9nOmSoU-FsG1BBLZW6cvg1e5NJtXbnLPg

# ── External API Configuration ────────────────────────────────────────────
# Optional: API endpoint for additional backend services
# Leave as default if not using external APIs
API_URL=https://api.example.com

# Optional: API key for external services
# Leave as default if not using external APIs
API_KEY=your_api_key_here

# ── Security Configuration ────────────────────────────────────────────────
# Build fingerprint for security verification
# Development: Keep as AXE_UNVERIFIED
# Production: Should be set during build process
AXE_SIG=AXE_UNVERIFIED

# ── Build Information ────────────────────────────────────────────────────
# Build fingerprint (usually auto-generated)
BUILD_FINGERPRINT=DEV_LOCAL

# Commit hash (usually auto-generated from git)
# Used for traceability and versioning
COMMIT_HASH=local_dev

# Build timestamp (usually auto-generated)
BUILD_TIMESTAMP=dev

# Application version (semantic versioning)
APP_VERSION=1.0.0

# ============================================================================
# QUICK START INSTRUCTIONS:
# ============================================================================
# 1. Development Setup:
#    - Copy this file to .env
#    - Use the default placeholder values
#    - App will run in development mode with test data
#
# 2. Production Setup:
#    - Replace SUPABASE_URL with your real project URL
#    - Replace SUPABASE_ANON_KEY with your real key
#    - Set AXE_SIG to your production signature
#
# 3. To Run with .env:
#    flutter run --dart-define-from-file=.env
#
# 4. To Build Release:
#    flutter build apk --dart-define-from-file=.env
#    flutter build ios --dart-define-from-file=.env
# ============================================================================

