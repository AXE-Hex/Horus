# ============================================================
# HORUS — Repository Ignore Policy
# ============================================================

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors / IDE
.idea/
*.iml
*.ipr
*.iws
.history/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Dart / Flutter
.dart_tool/
.packages
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
build/
**/build/
coverage/
doc/api/
**/ios/Flutter/.last_build_id

# Generated Dart sources — regenerated locally and in CI
**/*.g.dart
**/*.freezed.dart
**/*.gr.dart
**/*.gen.dart

# Generated platform files
**/Flutter/ephemeral/
**/flutter/ephemeral/
**/.plugin_symlinks/

# Android local/build outputs
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
*.apk
*.aab

# Signing / certificates — never commit
android/key.properties
**/key.properties
*.jks
*.keystore
*.p12
*.mobileprovision
*.cer
*.pem
*.key

# Apple generated dependencies
ios/Pods/
macos/Pods/
DerivedData/

# Environment / secrets
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/

# Supabase local runtime
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*
supabase/functions/.env
supabase/functions/.env.*

# Database dumps / backups
*.dump
*.backup
*.bak
database-dumps/
backups/

# Logs / reports / temporary output
*.log
*.tmp
*.temp
audit_report.txt
reports/local/
tmp/
temp/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Misc generated
migrate_working_dir/
.build/
.buildlog/
.swiftpm/
